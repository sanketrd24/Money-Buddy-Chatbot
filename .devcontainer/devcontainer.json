{
  "name": "Money Buddy Chatbot - Flutter Dev",
  "image": "mcr.microsoft.com/devcontainers/flutter:1-ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code",
        "esbenp.prettier-vscode",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "dart.flutterSdkPath": "/usr/local/flutter",
        "editor.formatOnSave": true
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "forwardPorts": [8080, 3000, 5037],
  "portsAttributes": {
    "8080": {
      "label": "Flutter Web App",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Dev Server",
      "onAutoForward": "notify"
    },
    "5037": {
      "label": "ADB Daemon",
      "onAutoForward": "silent"
    }
  }
}
